# Limoni Voice Relay Server Configuration
# 8080 gibi yaygın portlar yerine çakışma ve tarama riskini önlemek için özel port:
PORT=27850

# İsteğe Bağlı: Sunucunuzu şifrelemek için gizli token
# Boş bırakılırsa sunucu halka açık modda çalışır.
# Belirlenirse istemciler '--relay-token' veya '?token=' ile bağlanmalıdır.
RELAY_AUTH_TOKEN=super_secret_relay_key_change_me

# İsteğe Bağlı: Kendi alan adınızla kalıcı tünel için Cloudflare Zero Trust Token'ı
# Eğer tüneli 'quick-tunnel' profiliyle başlatırsanız bu tokene ihtiyaç yoktur (ücretsiz trycloudflare.com URL'i atanır).
CLOUDFLARE_TUNNEL_TOKEN=
