# Limoni Voice Relay Server Configuration
PORT=8080

# Set a strong secret token to protect your relay server from unauthorized access.
# If left empty, the server operates in public open mode.
# When set, clients must connect with: --relay-token <token> or LIMONI_RELAY_TOKEN=<token>
RELAY_AUTH_TOKEN=super_secret_relay_key_change_me

# Optional: Cloudflare Zero Trust Named Tunnel Token
# If left empty and running with '--profile tunnel', a free quick trycloudflare URL will be used.
CLOUDFLARE_TUNNEL_TOKEN=
